    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",

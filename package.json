{
  "name": "maeghens-unicorns",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Maeghen's Unicorns — an animated field guide to the animal that never was.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",

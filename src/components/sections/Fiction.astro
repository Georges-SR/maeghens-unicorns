---
/** "In fiction": a filterable shelf; filtering animates the layout with GSAP Flip. */
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { fiction, fictionFilters } from '@/content/fiction';
---

<section class="fiction" id="fiction" aria-labelledby="fiction-title" data-fiction>
  <SectionHeader
    sectionId="fiction"
    eyebrow="In fiction"
    title="The unicorn <em>goes modern</em>"
    lede="Once it stopped being a real animal, the unicorn became something better: a character."
  />

  <div class="filters" role="group" aria-label="Filter stories" data-reveal>
    {fictionFilters.map((f, i) => (
      <button type="button" class="chip" data-filter={f.kind} aria-pressed={i === 0 ? 'true' : 'false'}>
        {f.label}
      </button>
    ))}
  </div>

  <ul class="shelf" data-shelf>
    {fiction.map((entry) => (
      <li class="book" data-kind={entry.kind} data-reveal>
        <span class="book__year">{entry.year}</span>
        <h3>{entry.title}</h3>
        <p class="book__who label">{entry.who}</p>
        <p class="book__body" set:html={entry.body} />
      </li>
    ))}
  </ul>
</section>

<script>
  import { forEach } from '@/scripts/core/dom';
  import { initFiction } from '@/scripts/sections/fiction';

  forEach('[data-fiction]', initFiction);
</script>

<style>
  .fiction {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: clamp(5rem, 14vh, 9rem) var(--gutter);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 2.5rem;
  }

  .chip {
    padding: 0.65em 1.25em;
    border: 1px solid var(--c-line);
    border-radius: 999px;
    background: transparent;
    color: var(--c-ivory-dim);
    font: 400 0.78rem/1 var(--f-sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      color 0.3s,
      border-color 0.3s,
      background-color 0.3s;
  }

  .chip:hover {
    color: var(--c-gold-hi);
    border-color: var(--c-gold);
  }

  .chip[aria-pressed='true'] {
    background: var(--c-gold);
    border-color: var(--c-gold);
    color: var(--c-ink);
  }

  .shelf {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 270px), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .book {
    position: relative;
    overflow: hidden;
    padding: 2rem 1.7rem 2.2rem;
    border: 1px solid rgb(201 164 92 / 0.14);
    border-radius: var(--radius);
    background: var(--c-ink);
    transition: border-color 0.5s;
  }

  .book::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 80% at 0% 0%, rgb(58 91 148 / 0.2), transparent 60%);
    opacity: 0;
    transition: opacity 0.6s;
  }

  .book:hover {
    border-color: rgb(201 164 92 / 0.4);
  }

  .book:hover::before {
    opacity: 1;
  }

  .book > * {
    position: relative;
  }

  .book:global(.is-hidden) {
    display: none;
  }

  .book__year {
    display: block;
    margin-bottom: 1rem;
    font: italic 500 2.6rem/1 var(--f-serif);
    color: var(--c-gold);
    font-variant-numeric: oldstyle-nums;
    transition: color 0.4s;
  }

  .book:hover .book__year {
    color: var(--c-gold-hi);
  }

  .book h3 {
    margin-bottom: 0.4rem;
    font-size: 1.45rem;
  }

  .book__who {
    margin: 0 0 1rem;
    color: var(--c-lapis-hi);
  }

  .book__body {
    margin: 0;
    font-size: 0.95rem;
    color: var(--c-ivory-dim);
  }
</style>
